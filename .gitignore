# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/
.coverage
htmlcov/

# Local configuration and secrets
config.yaml
.env

# Biometric data, logs and raw experiment data: never commit
profiles/*
!profiles/.gitkeep
logs/*
!logs/.gitkeep
# raw per-frame scores, per-trial events and calibration embeddings stay local;
# aggregated metrics/plots (no biometric data) may be committed
results/raw/
datasets/

# Model weights (downloaded to ~/.deepface/weights by default)
*.h5
*.onnx
*.pth
