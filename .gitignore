# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/
.coverage
htmlcov/

# Local configuration and secrets
config.yaml
.env

# Biometric data, logs and raw experiment data: never commit
profiles/*
